{
  "name": "anvil-cc",
  "version": "0.1.0",
  "description": "Iterative code forging engine for Claude Code — auto-fixes with retry loops, smart chunking, and cross-session learning",
  "type": "module",
  "bin": {
    "anvil-cc": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/templates dist/templates",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "dist/**/*",
    "src/templates/**/*"
  ],
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "iteration",
    "auto-fix",
    "tdd",
    "testing",
    "debugging",
    "ai-coding",
    "developer-tools"
  ],
  "author": "Abdullah <abdullah1854@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdullah1854/Anvil.git"
  },
  "homepage": "https://github.com/abdullah1854/Anvil#readme",
  "bugs": {
    "url": "https://github.com/abdullah1854/Anvil/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vitest": "^3.0.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
